                <td></td>
                <td>(50,000,000)</td>
            </tr>
            <tr class="total-row">
                <td colspan="2">Total Arus Kas dari Aktivitas Operasi</td>
                <td>150,000,000</td>
            </tr>

            <!-- Arus Kas dari Aktivitas Investasi -->
            <tr>
                <td colspan="3" style="background-color: #cce5ff; font-weight: bold;">Arus Kas dari Aktivitas Investasi</td>
            </tr>
            <tr>
                <td>Pembelian Aset Tetap</td>
                <td></td>
                <td>(100,000,000)</td>
            </tr>
            <tr>
                <td>Penjualan Investasi</td>
                <td></td>
                <td>50,000,000</td>
            </tr>
            <tr class="total-row">
                <td colspan="2">Total Arus Kas dari Aktivitas Investasi</td>
                <td>(50,000,000)</td>
            </tr>

            <!-- Arus Kas dari Aktivitas Pendanaan -->
            <tr>
                <td colspan="3" style="background-color: #cce5ff; font-weight: bold;">Arus Kas dari Aktivitas Pendanaan</td>
            </tr>
