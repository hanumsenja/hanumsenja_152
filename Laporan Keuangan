    <!-- Tabel Laporan Arus Kas -->
    <table>
        <thead>
            <tr>
                <th colspan="2">Uraian</th>
                <th>Jumlah (Rp)</th>
            </tr>
        </thead>
        <tbody>
            <!-- Arus Kas dari Aktivitas Operasi -->
            <tr>
                <td colspan="3" style="background-color: #cce5ff; font-weight: bold;">Arus Kas dari Aktivitas Operasi</td>
            </tr>
            <tr>
                <td>Penerimaan dari Pelanggan</td>
                <td></td>
