                <td>200,000,000</td>
            </tr>
            <tr>
                <td>Pembayaran Dividen</td>
                <td></td>
                <td>(50,000,000)</td>
            </tr>
            <tr class="total-row">
                <td colspan="2">Total Arus Kas dari Aktivitas Pendanaan</td>
                <td>150,000,000</td>
            </tr>

            <!-- Total Arus Kas Bersih -->
